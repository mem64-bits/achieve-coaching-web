{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(npm run verify)",
      "Bash(npm run test:hooks)",
      "Bash(npm test*)",
      "Bash(npx astro check)",
      "Bash(npx vitest run *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "mcp__astro-docs"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npx shadcn@latest add *)",
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.vercel/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(vercel --prod*)",
      "Bash(vercel deploy --prod*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs"
            ],
            "timeout": 15,
            "statusMessage": "Checking branch and file rules"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/verify.mjs"
            ],
            "timeout": 240,
            "statusMessage": "Running astro check and unit tests"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "resend@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },
  "env": {
    "ASTRO_TELEMETRY_DISABLED": "1"
  }
}
