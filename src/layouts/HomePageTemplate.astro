---
// src/layouts/HomePageTemplate.astro
import BaseLayout from "./BaseLayout.astro";
import {
    HeroSection,
    ResultsMosaicSection,
    HowItWorksSection,
    QualificationSection,
} from "../components/home";
import ContactFormSection from "../components/home/ContactFormSection";
---

<BaseLayout title="Achieve Coaching | Home">
    <div slot="page-main" class="w-full h-full overflow-y-auto scrollbar-none flex flex-col">
        <HeroSection/>
        <ResultsMosaicSection/>
        <HowItWorksSection/>
        <QualificationSection/>
        <ContactFormSection client:visible/>
    </div>
</BaseLayout>