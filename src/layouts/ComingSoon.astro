---
import BaseLayout from "./BaseLayout.astro";
import {AchieveBtn} from "@components/common/AchieveBtn";
import {SectionContainer} from "@components/common/SectionContainer";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "A preview of the upcoming Achieve Coaching website",
} = Astro.props;
---

<BaseLayout title={title} description={description} noindex>
    <SectionContainer maxWidth="narrow" paddingTop="normal" className="flex grow flex-col items-center justify-center gap-6 text-center">
        <h1 class="font-display text-title font-extrabold uppercase text-balance text-foreground">
            Achieve Coaching page in progress!
        </h1>
        <p class="eyebrow text-muted-foreground">
            Please come back later to see the latest improvements to our website.
        </p>
        <slot name="coming-soon-extras"/>
        <AchieveBtn href="/" variant="outline">Back to home</AchieveBtn>
    </SectionContainer>
</BaseLayout>
