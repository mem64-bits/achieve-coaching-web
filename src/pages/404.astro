---
import BaseLayout from "@layouts/BaseLayout.astro";
import {AchieveBtn} from "@components/common/AchieveBtn";
import {SectionContainer} from "@components/common/SectionContainer";
import {SITE} from "@constants/site";
---

<BaseLayout title={`Page not found | ${SITE.name}`} noindex>
    <SectionContainer maxWidth="narrow" paddingTop="normal" className="flex grow flex-col items-center justify-center gap-6 text-center">
        <p class="eyebrow">Error 404</p>
        <h1 class="font-display text-title font-extrabold uppercase text-balance text-foreground">
            This page doesn't exist
        </h1>
        <p class="text-lead text-muted-foreground">The link may be old, or the page may have moved.</p>
        <AchieveBtn href="/" size="lg">Back to home</AchieveBtn>
    </SectionContainer>
</BaseLayout>
