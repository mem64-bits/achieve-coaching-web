---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import AchieveSeparator from '../components/AchieveSeparator';

// Placeholder data (Eventually from Turso)
const stats = [
    {label: "Active Clients", value: "50+"},
    {label: "Kg Lost", value: "1,200+"},
    {label: "Success Rate", value: "98%"},
];
---

<BaseLayout title="Achieve Coaching | Peak Performance">
    <div slot="page-main" class="w-full h-full overflow-y-auto scrollbar-none flex flex-col gap-24 py-12 px-4 md:px-12">

        <!-- SECTION 1: HERO STATEMENT -->
        <section class="flex flex-col items-center text-center space-y-6 max-w-4xl mx-auto">
            <div class="inline-block px-3 py-1 rounded-full border border-achieve-blue/20 bg-achieve-blue/5 text-[10px] font-bold tracking-[0.4em] uppercase text-achieve-blue animate-in fade-in slide-in-from-bottom-4 duration-1000">
                Elite Fitness Mentorship
            </div>
            <h1 class="text-4xl md:text-7xl font-black tracking-tighter uppercase leading-[0.9] text-white">
                Transform your <span class="text-achieve-blue">Physics</span><br/>
                Master your <span class="text-achieve-blue">Mind</span>
            </h1>
            <p class="text-zinc-500 text-xs md:text-sm tracking-[0.2em] uppercase max-w-2xl leading-relaxed">
                A science-based protocol designed for high-performers who demand results.
            </p>
        </section>

        <!-- SECTION 2: BENTO STATS -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-4 w-full max-w-6xl mx-auto">
            {stats.map((stat) => (
                    <div class="group relative p-8 rounded-3xl bg-white/[0.02] border border-white/5 overflow-hidden transition-all hover:border-achieve-blue/30">
                        <div class="absolute -bottom-10 -right-10 w-32 h-32 bg-achieve-blue/5 blur-3xl group-hover:bg-achieve-blue/10 transition-colors"/>
                        <span class="text-[10px] font-bold tracking-[0.3em] uppercase text-zinc-500">{stat.label}</span>
                        <h2 class="text-4xl font-black text-white mt-2">{stat.value}</h2>
                    </div>
            ))}
        </section>

        <!-- SECTION 3: THE SEPARATOR BREAK -->
        <div class="max-w-md mx-auto w-full">
            <AchieveSeparator thickness="1px" variant="glow"/>
        </div>

        <!-- SECTION 4: TRANSFORMATION PREVIEW (Cloudinary Placeholder) -->
        <section class="w-full max-w-6xl mx-auto space-y-12">
            <div class="flex flex-col md:flex-row justify-between items-end gap-4">
                <h2 class="text-3xl font-black uppercase tracking-tighter">Latest <span class="text-achieve-blue">Results</span>
                </h2>
                <a href="/transformations"
                   class="text-[10px] font-bold tracking-widest uppercase text-zinc-500 hover:text-white transition-colors">View
                    All Case Studies →</a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="aspect-video rounded-3xl bg-zinc-900 border border-white/5 overflow-hidden relative group">
                    <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent z-10"/>
                    <div class="absolute bottom-8 left-8 z-20">
                        <span class="text-achieve-blue font-bold text-[10px] tracking-widest uppercase">12 Week Protocol</span>
                        <h3 class="text-2xl font-black uppercase">Client: Alex M.</h3>
                    </div>
                    <!-- Replace with <img src={...} /> later -->
                </div>
                <div class="aspect-video rounded-3xl bg-zinc-900 border border-white/5 overflow-hidden relative group">
                    <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent z-10"/>
                    <div class="absolute bottom-8 left-8 z-20">
                        <span class="text-achieve-blue font-bold text-[10px] tracking-widest uppercase">Muscle Hypertrophy</span>
                        <h3 class="text-2xl font-black uppercase">Client: Sarah J.</h3>
                    </div>
                </div>
            </div>
        </section>

    </div>
</BaseLayout>