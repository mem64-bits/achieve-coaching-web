---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import AchieveSeparator from '@components/AchieveSeparator';
import AchieveCarousel from '@components/AchieveCarousel';

const stats = [
    {label: "Active Clients", value: "50+"},
    {label: "Kg Lost", value: "1,200+"},
    {label: "Success Rate", value: "98%"},
];
---

<BaseLayout title="Achieve Coaching | Home">
    <div slot="page-main" class="w-full h-full overflow-y-auto scrollbar-none flex flex-col gap-24 py-16 px-6 md:px-12">

        <!-- SECTION 1: PHILOSOPHY STATEMENT -->
        <section class="flex flex-col items-center text-center space-y-8 max-w-225 mx-auto shrink-0">
            <div class="inline-block px-4 py-1.5 rounded-full border border-achieve-blue/20 bg-achieve-blue/5 text-[10px] font-bold tracking-[0.4em] uppercase text-achieve-blue animate-in fade-in slide-in-from-bottom-4 duration-1000">
                Elite Fitness Coaching
            </div>

            <h1 class="text-4xl md:text-7xl font-black uppercase text-white
           leading-[1.1] md:leading-[1.1]
           tracking-tight">
                Transform your <span class="text-achieve-blue">Physique</span><br/>
                Master your <span class="text-achieve-blue">Mind</span>
            </h1>
            <p class="text-zinc-500 text-xs md:text-sm tracking-[0.2em] uppercase max-w-2xl leading-relaxed">
                A tried and tested program with real results, making your fitness oriented goals a reality.
            </p>
        </section>

        <!-- SECTION 2: BENTO STATS -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-4 w-full max-w-300 mx-auto shrink-0">
            {stats.map((stat) => (
                    <div class="group relative p-10 rounded-4xl bg-white/2 border border-white/5 overflow-hidden transition-all duration-500 hover:border-achieve-blue/30 hover:bg-white/4">
                        <div class="absolute -bottom-12 -right-12 w-40 h-40 bg-achieve-blue/10 blur-[80px] rounded-full group-hover:bg-achieve-blue/20 transition-colors duration-500"/>
                        <span class="relative z-10 text-[10px] font-bold tracking-[0.4em] uppercase text-zinc-500 group-hover:text-achieve-blue transition-colors">{stat.label}</span>
                        <h2 class="relative z-10 text-5xl font-black text-white mt-4 tracking-tighter">{stat.value}</h2>
                    </div>
            ))}
        </section>

        <!-- SECTION 3: THE SEPARATOR BREAK -->
        <div class="max-w-100 mx-auto w-full shrink-0">
            <AchieveSeparator thickness="2px" variant="glow" color="#3b43c1"/>
        </div>
        <section class="w-full py-20 overflow-visible px-4">
            <AchieveCarousel client:visible/>
        </section>

    </div>
</BaseLayout>