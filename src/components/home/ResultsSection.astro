---
import {SectionContainer} from "@components/common/SectionContainer";
import {SectionTitle} from "@components/common/SectionTitle";
import ResultsGallery from "@components/results/ResultsGallery";
import {QuoteCard} from "./QuoteCard";
import ReviewsCarousel from "./ReviewsCarousel";
import {RESULT_PHOTOS} from "@constants/resultPhotos";
import {RESULTS_SECTION as copy, TESTIMONIALS as testimonials} from "@constants/results";
import {toResponsiveImage} from "@/lib/images";
import type {GalleryPhoto} from "@/types/results";
import type {PhotoHover} from "@components/results/ResultsGallery";
import type {CarouselMotion} from "@components/common/SwipeCarousel";

interface Props {
    // What photo cards do under the pointer; see ResultsGallery.
    photoHover?: PhotoHover;
    carouselMotion?: CarouselMotion;
}

const {photoHover = "none", carouselMotion = "transition"} = Astro.props;

const titleId = `${copy.id}-title`;

// Strip photos are 3:4 cards: one at a time below 1024px (the screen minus
// its margins, never over 26rem), then three side by side in a carousel
// capped at 1100px wide, so about a third of that each.
const THUMB_WIDTHS = [320, 480, 720, 960];
const FULL_WIDTHS = [720, 1080, 1440];

const photos: GalleryPhoto[] = await Promise.all(
    RESULT_PHOTOS.map(async (photo, index) => {
        const aspectRatio = photo.image.width / photo.image.height;

        return {
            id: `result-${index + 1}`,
            aspectRatio,
            showWhole: photo.showWhole ?? false,
            kind: photo.kind,
            thumb: await toResponsiveImage(photo.image, {
                alt: photo.alt,
                widths: THUMB_WIDTHS,
                sizes: "(min-width: 1024px) min(32vw, 360px), min(calc(100vw - 2rem), 416px)",
                quality: {avif: 50, webp: 68},
                placeholder: true,
            }),
            full: await toResponsiveImage(photo.image, {
                alt: photo.alt,
                widths: FULL_WIDTHS,
                sizes: `min(100vw, ${(aspectRatio * 82).toFixed(1)}vh)`,
            }),
        };
    }),
);
---

<!-- Full width so the photo strip runs edge to edge on every screen.
     The title and reviews keep their own widths. -->
<SectionContainer
    id={copy.id}
    maxWidth="full"
    aria-labelledby={titleId}
>
    <SectionTitle
        id={titleId}
        eyebrow={copy.eyebrow}
        titleStart={copy.titleStart}
        titleAccent={copy.titleAccent}
        description={copy.hint}
        align="center"
        className="mb-8 sm:mb-10"
    />

    <ResultsGallery client:visible={{rootMargin: "600px"}} photos={photos} hover={photoHover} motion={carouselMotion}/>

    {testimonials.length === 1 && (
        <div class="mx-auto mt-10 max-w-[44rem] sm:mt-14">
            <QuoteCard {...testimonials[0]}/>
        </div>
    )}

    {testimonials.length > 1 && (
        <>
            {copy.testimonialsTitle && (
                <h3 id={copy.testimonialsId} class="mt-14 mb-6 text-center font-display text-subtitle font-bold uppercase text-foreground sm:mt-20">
                    {copy.testimonialsTitle} <span class="text-achieve-blue">{copy.testimonialsAccent}</span>
                </h3>
            )}
            <ReviewsCarousel
                client:visible={{rootMargin: "600px"}}
                testimonials={testimonials}
                label={`${copy.testimonialsTitle} ${copy.testimonialsAccent}`}
            />
        </>
    )}
</SectionContainer>
