---
import {SectionContainer} from "@components/common/SectionContainer";
import {SectionTitle} from "@components/common/SectionTitle";
import ResultsGallery from "@components/results/ResultsGallery";
import {QuoteCard} from "./QuoteCard";
import {RESULT_PHOTOS} from "@constants/resultPhotos";
import {RESULTS_SECTION, TESTIMONIALS} from "@constants/results";
import {SECTION_IDS} from "@constants/site";
import {toResponsiveImage} from "@/lib/images";
import type {GalleryPhoto} from "@/types/results";

const THUMB_HEIGHT = 480;
const THUMB_WIDTHS = [320, 480, 720];
const FULL_WIDTHS = [640, 960, 1280, 1600];

const photos: GalleryPhoto[] = await Promise.all(
    RESULT_PHOTOS.map(async (photo, index) => {
        const aspectRatio = photo.image.width / photo.image.height;
        const mobileWidth = Math.round(THUMB_HEIGHT * aspectRatio);

        return {
            id: `result-${index + 1}`,
            kind: photo.kind,
            thumb: await toResponsiveImage(photo.image, {
                alt: photo.alt,
                widths: THUMB_WIDTHS,
                quality: 70,
                sizes: `(min-width: 1280px) 400px, (min-width: 1024px) 31vw, ${mobileWidth}px`,
            }),
            full: await toResponsiveImage(photo.image, {
                alt: photo.alt,
                widths: FULL_WIDTHS,
                sizes: `min(100vw, ${(aspectRatio * 82).toFixed(1)}vh)`,
                quality: 72,
            }),
        };
    }),
);
---

<SectionContainer id={SECTION_IDS.results} maxWidth="wide" aria-labelledby="results-title">
    <SectionTitle
        id="results-title"
        eyebrow={RESULTS_SECTION.eyebrow}
        titleStart={RESULTS_SECTION.titleStart}
        titleAccent={RESULTS_SECTION.titleAccent}
        description={RESULTS_SECTION.hint}
        className="mb-8 sm:mb-10"
    />

    <ResultsGallery client:visible={{rootMargin: "600px"}} photos={photos}/>

    <h3 class="mt-14 mb-6 font-display text-subtitle font-bold uppercase text-foreground sm:mt-20">
        {RESULTS_SECTION.testimonialsTitle}
    </h3>
    <ul
        tabindex="0"
        aria-label={RESULTS_SECTION.testimonialsTitle}
        class="snap-row -mx-gutter items-start px-gutter pb-2 lg:mx-0 lg:grid lg:grid-cols-3 lg:items-stretch lg:gap-5 lg:overflow-visible lg:px-0">
        {TESTIMONIALS.map((testimonial) => (
            <li class="w-[85%] max-w-[22rem] shrink-0 lg:w-auto lg:max-w-none">
                <QuoteCard {...testimonial}/>
            </li>
        ))}
    </ul>
</SectionContainer>
