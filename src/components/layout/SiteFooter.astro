---
import {Phone} from "lucide-react";
import BrandLogo from "./BrandLogo.astro";
import {SocialLinks} from "./SocialLinks";
import {SECTION_IDS, SITE} from "@constants/site";
import {SOCIAL_LINKS} from "@constants/socials";
---

<footer class="mt-auto border-t border-white/5 bg-linear-to-t from-black via-card/40 to-transparent">
    <div class="mx-auto flex max-w-[1100px] flex-col items-center gap-10 px-gutter pt-14 pb-[max(2rem,env(safe-area-inset-bottom))] md:flex-row md:items-end md:justify-between">
        <div class="order-2 flex flex-col items-center gap-2.5 md:order-1 md:items-start">
            <a href="/" aria-label={`${SITE.name} home`} class="block w-32 opacity-90 transition-opacity hover:opacity-100">
                <BrandLogo/>
            </a>
            <p class="text-[0.6875rem] uppercase tracking-[0.3em] text-muted-foreground">
                <span class="sr-only">{SITE.name} </span>&copy; {SITE.foundedYear}
            </p>
        </div>

        <div id={SECTION_IDS.contact} class="order-1 flex flex-col items-center gap-3 md:order-2 md:items-end">
            <h2 class="eyebrow flex items-center gap-2 text-muted-foreground">
                <Phone aria-hidden="true" className="size-4 text-achieve-blue"/>
                Contact us
            </h2>
            <SocialLinks links={SOCIAL_LINKS} className="gap-3" showLabels/>
        </div>
    </div>
</footer>
