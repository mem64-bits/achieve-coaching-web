---
import BrandLogo from "./BrandLogo.astro";
import {AchieveBtn} from "@components/common/AchieveBtn";
import {HEADER_LINKS, PRIMARY_CTA, SITE} from "@constants/site";

const linkClass =
    "inline-flex min-h-11 items-center whitespace-nowrap font-display font-bold uppercase text-subtle transition-colors hover:text-achieve-blue";
---

<header class="site-header sticky top-0 z-50 pt-[env(safe-area-inset-top)]">
    <div class="site-header__bar">
        <div class="mx-auto flex h-header max-w-[90rem] items-center justify-between gap-3 px-gutter lg:grid lg:grid-cols-[1fr_auto_1fr] lg:gap-8">
            <a
                href="/"
                aria-label={`${SITE.name} home`}
                class="block min-w-0 shrink grow-0 basis-[clamp(10rem,48vw,17rem)] transition-opacity hover:opacity-85 lg:w-[clamp(13rem,18vw,17rem)]"
            >
                <BrandLogo/>
            </a>

            <nav aria-label="Main" class="hidden lg:block">
                <ul class="flex items-center gap-8 xl:gap-10">
                    {HEADER_LINKS.map((link) => (
                        <li><a href={link.href} class:list={[linkClass, "text-sm tracking-[0.12em]"]}>{link.label}</a></li>
                    ))}
                </ul>
            </nav>

            <AchieveBtn
                href={PRIMARY_CTA.href}
                size="sm"
                className="shrink-0 justify-self-end max-[400px]:px-3 max-[400px]:text-[0.75rem] max-[400px]:tracking-[0.02em]"
            >
                {PRIMARY_CTA.headerLabel}
            </AchieveBtn>
        </div>

        <nav aria-label="Main" class="border-t border-white/5 lg:hidden">
            <ul class="snap-row mx-auto max-w-[90rem] justify-center-safe gap-6 px-gutter sm:gap-8">
                {HEADER_LINKS.map((link) => (
                    <li>
                        <a href={link.href} aria-label={link.label} class:list={[linkClass, "min-h-9 text-[0.6875rem] tracking-[0.1em] sm:text-xs sm:tracking-[0.12em]"]}>
                            <span class="sm:hidden" aria-hidden="true">{link.shortLabel}</span>
                            <span class="hidden sm:inline" aria-hidden="true">{link.label}</span>
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
    <div aria-hidden="true" class="site-header__rim relative h-px">
        <div class="scroll-progress"></div>
    </div>
</header>
