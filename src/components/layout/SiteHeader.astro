---
import BrandLogo from "./BrandLogo.astro";
import {AchieveBtn} from "@components/common/AchieveBtn";
import {PRIMARY_CTA, SITE} from "@constants/site";
---

<header class="site-header sticky top-0 z-50 pt-[env(safe-area-inset-top)]">
    <div class="site-header__bar">
        <div class="mx-auto flex h-header max-w-[90rem] items-center justify-between gap-3 px-gutter">
            <a
                href="/"
                aria-label={`${SITE.name} home`}
                class="block min-w-0 shrink grow-0 basis-[clamp(10rem,48vw,17rem)] transition-opacity hover:opacity-85"
            >
                <BrandLogo/>
            </a>
            <AchieveBtn
                href={PRIMARY_CTA.href}
                size="sm"
                className="shrink-0 max-[400px]:px-3 max-[400px]:text-[0.75rem] max-[400px]:tracking-[0.02em]"
            >
                {PRIMARY_CTA.headerLabel}
            </AchieveBtn>
        </div>
    </div>
    <div aria-hidden="true" class="site-header__rim relative h-px">
        <div class="scroll-progress"></div>
    </div>
</header>
