---
import BrandLogo from "./BrandLogo.astro";
import {AchieveBtn} from "@components/common/AchieveBtn";
import {HEADER_LINKS, PRIMARY_CTA, SECTION_IDS, SITE} from "@constants/site";

// `section-link` carries the tubelight lamp (see effects.css); the colour
// change for the current section lives there too so both navs match.
const linkClass =
    "section-link inline-flex items-center whitespace-nowrap font-display font-bold uppercase text-subtle transition-colors hover:text-white";
---

<header class="site-header sticky top-0 z-50 pt-[env(safe-area-inset-top)]">
    <div class="site-header__bar">
        <div class="mx-auto flex h-header max-w-[90rem] items-center justify-between gap-3 px-gutter lg:grid lg:grid-cols-[1fr_auto_1fr] lg:gap-8">
            <a
                href="/"
                aria-label={`${SITE.name} home`}
                class="block min-w-0 shrink grow-0 basis-[clamp(10rem,48vw,17rem)] transition-opacity hover:opacity-85 lg:w-[clamp(13rem,18vw,17rem)]"
            >
                <BrandLogo shine/>
            </a>

            <nav aria-label="Main" data-section-nav class="section-nav hidden lg:block">
                <!-- Not shown or announced. It gives the scroll tracking a target for
                     the hero, so no section lamp is lit while you're at the top. -->
                <a href={`#${SECTION_IDS.top}`} tabindex="-1" aria-hidden="true" class="sr-only">Top</a>
                <ul class="section-nav__track flex items-center gap-1 rounded-full px-1.5">
                    {HEADER_LINKS.map((link) => (
                        <li><a href={link.href} class:list={[linkClass, "min-h-10 rounded-full px-4 text-sm tracking-[0.12em] xl:px-5"]}>{link.label}</a></li>
                    ))}
                </ul>
            </nav>

            <AchieveBtn
                href={PRIMARY_CTA.href}
                size="sm"
                variant="outline"
                effect="beam"
                className="shrink-0 border-achieve-blue/45 bg-achieve-blue/10 text-white hover:bg-achieve-blue/20 justify-self-end max-[400px]:px-3 max-[400px]:text-[0.75rem] max-[400px]:tracking-[0.02em]"
            >
                {PRIMARY_CTA.headerLabel}
            </AchieveBtn>
        </div>

        <nav aria-label="Main" data-section-nav class="section-nav border-t border-white/5 lg:hidden">
            <a href={`#${SECTION_IDS.top}`} tabindex="-1" aria-hidden="true" class="sr-only">Top</a>
            <ul class="snap-row mx-auto max-w-[90rem] justify-center-safe gap-6 px-gutter sm:gap-8">
                {HEADER_LINKS.map((link) => (
                    <li>
                        <a href={link.href} class:list={[linkClass, "min-h-11 px-1 text-[0.6875rem] tracking-[0.1em] sm:text-xs sm:tracking-[0.12em]"]}>
                            {/* Only one label is displayed at a time, so the link's spoken name always
                                matches the words on screen (voice control users say what they see). */}
                            <span class="sm:hidden">{link.shortLabel}</span>
                            <span class="hidden sm:inline">{link.label}</span>
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
    <div aria-hidden="true" class="site-header__rim relative h-px">
        <div class="scroll-progress"></div>
    </div>
</header>

<script>
    import {SectionSpy} from "@/lib/navigation/SectionSpy";

    new SectionSpy().start();
</script>
